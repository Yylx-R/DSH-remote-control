* text=auto

# 跨平台脚本的换行：sh 用 LF，Windows 脚本用 CRLF
*.sh    text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制
*.jks   binary
*.keystore binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.apk   binary
*.aab   binary
*.jar   binary

gradlew   text eol=lf
*.cjs    text eol=lf
Dockerfile text eol=lf
Caddyfile  text eol=lf
